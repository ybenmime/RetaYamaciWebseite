# E-Mail-Versand für das Kontaktformular (anfrage.html)
#
# DEV-MODUS: Wenn SMTP_HOST / SMTP_USER / SMTP_PASS leer bleiben, werden
# E-Mails NICHT verschickt, sondern nur in der Server-Konsole ausgegeben.
# Das Formular funktioniert dann lokal zum Testen.
#
# Für echten Versand alle SMTP-Werte ausfüllen.

# --- SMTP-Zugangsdaten ---
# Gmail-Beispiel:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465
#                  SMTP_USER=deinkonto@gmail.com  SMTP_PASS=<App-Passwort>
# (Gmail braucht ein App-Passwort, nicht das normale Passwort:
#  Google-Konto → Sicherheit → 2-Schritt-Verifizierung → App-Passwörter)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Absender-Adresse (optional; Standard = SMTP_USER)
SENDER_EMAIL=

# Empfänger: E-Mail-Adresse der Stylistin (Reta)
RECIPIENT_EMAIL=

# Port für den lokalen Server
PORT=3001
